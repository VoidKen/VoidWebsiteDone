# Backend / serverless only — set these in Vercel Project Settings > Environment
# Variables, NOT in a .env file you commit.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# Discord login (Discord Developer Portal > your app > OAuth2)
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_REDIRECT_URI=https://your-domain.vercel.app/api/auth/callback

# Any random long string — used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string

# Your own Discord user ID — only this account can access /admin.
# Get it: Discord Settings > Advanced > Developer Mode on, then
# right-click your name anywhere > Copy User ID.
ADMIN_DISCORD_ID=your_discord_user_id

# Set automatically when you connect the Vercel Postgres (Neon)
# integration in the Vercel dashboard — you shouldn't need to set this
# by hand.
# POSTGRES_URL=...
